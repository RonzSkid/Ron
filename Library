local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")

local LocalPlayer = Players.LocalPlayer

local Library = {}
Library.__index = Library

Library.Colors = {
    Window = Color3.fromRGB(0, 0, 0),
    Panel = Color3.fromRGB(0, 0, 0),
    Element = Color3.fromRGB(5, 5, 5),
    Hover = Color3.fromRGB(16, 16, 16),
    Border = Color3.fromRGB(38, 38, 38),
    Text = Color3.fromRGB(255, 255, 255),
    MutedText = Color3.fromRGB(220, 220, 220),
    Accent = Color3.fromRGB(255, 255, 255),
}

local function create(className, properties, parent)
    local object = Instance.new(className)
    for key, value in pairs(properties or {}) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function corner(parent, radius)
    return create("UICorner", {CornerRadius = UDim.new(0, radius or 5)}, parent)
end

local function stroke(parent, color, thickness)
    return create("UIStroke", {
        Color = color or Library.Colors.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function label(parent, text, size, position, dimensions, fontSize, alignment)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(text or ""),
        TextColor3 = Library.Colors.Text,
        Font = Enum.Font.Gotham,
        TextSize = fontSize or 13,
        TextXAlignment = alignment or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = dimensions or UDim2.new(1, -16, 0, 28),
        Position = position or UDim2.new(0, 8, 0, 0),
        AutomaticSize = size and Enum.AutomaticSize.None or Enum.AutomaticSize.None,
    }, parent)
end

local function button(parent, text, height)
    local b = create("TextButton", {
        AutoButtonColor = false,
        BackgroundColor3 = Library.Colors.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height or 30),
        Text = tostring(text or ""),
        TextColor3 = Library.Colors.Text,
        Font = Enum.Font.Gotham,
        TextSize = 13,
    }, parent)
    corner(b, 4)
    stroke(b)
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = Library.Colors.Hover}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = Library.Colors.Element}):Play()
    end)
    return b
end

local function makeList(parent, padding)
    local list = create("UIListLayout", {
        Padding = UDim.new(0, padding or 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, parent)
    return list
end

local function addPadding(parent, left, right, top, bottom)
    return create("UIPadding", {
        PaddingLeft = UDim.new(0, left or 8),
        PaddingRight = UDim.new(0, right or 8),
        PaddingTop = UDim.new(0, top or 8),
        PaddingBottom = UDim.new(0, bottom or 8),
    }, parent)
end

local function makeDraggable(window, handle)
    local dragging = false
    local dragInput
    local dragStart
    local startPosition

    handle.Active = true
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = window.Position
            dragInput = input
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    dragInput = nil
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - dragStart
            local camera = workspace.CurrentCamera
            if not camera then return end
            local viewport = camera.ViewportSize
            local inset = GuiService:GetGuiInset()
            local absoluteSize = window.AbsoluteSize
            local x = math.clamp(startPosition.X.Offset + delta.X, 0, math.max(0, viewport.X - absoluteSize.X))
            local y = math.clamp(startPosition.Y.Offset + delta.Y, inset.Y, math.max(inset.Y, viewport.Y - absoluteSize.Y))
            window.Position = UDim2.fromOffset(x, y)
        end
    end)
end

local WindowMethods = {}
WindowMethods.__index = WindowMethods
local TabMethods = {}
TabMethods.__index = TabMethods
local SectionMethods = {}
SectionMethods.__index = SectionMethods
local ToggleMethods = {}
ToggleMethods.__index = ToggleMethods

function Library:Window(options)
    options = options or {}
    local gui = create("ScreenGui", {
        Name = "RonzBlackUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    local parent
    local success = pcall(function()
        parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)
    if not success or not parent then
        parent = LocalPlayer:WaitForChild("PlayerGui")
    end
    gui.Parent = parent

    local scale = create("UIScale", {Scale = 1}, nil)
    scale.Parent = gui

    local root = create("Frame", {
        Name = "Main",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(620, 430),
        BackgroundColor3 = Library.Colors.Window,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, gui)
    corner(root, 7)
    stroke(root, Library.Colors.Border, 1)

    local titlebar = create("Frame", {
        Name = "Titlebar",
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Library.Colors.Panel,
        BorderSizePixel = 0,
    }, root)
    label(titlebar, options.name or options.Name or "Ronz", nil, UDim2.fromOffset(12, 0), UDim2.new(1, -50, 1, 0), 14)

    local close = create("TextButton", {
        Name = "Close",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(25, 25),
        BackgroundColor3 = Library.Colors.Element,
        BorderSizePixel = 0,
        Text = "×",
        TextColor3 = Library.Colors.Text,
        TextSize = 20,
        Font = Enum.Font.Gotham,
    }, titlebar)
    corner(close, 4)
    close.Activated:Connect(function() gui.Enabled = not gui.Enabled end)

    local tabBar = create("ScrollingFrame", {
        Name = "Tabs",
        Position = UDim2.fromOffset(8, 46),
        Size = UDim2.new(1, -16, 0, 34),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Library.Colors.Text,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.X,
        ScrollingDirection = Enum.ScrollingDirection.X,
    }, root)
    makeList(tabBar, 5)
    local tabLayout = tabBar:FindFirstChildOfClass("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal

    local content = create("Frame", {
        Name = "Content",
        Position = UDim2.fromOffset(8, 86),
        Size = UDim2.new(1, -16, 1, -94),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, root)

    local self = setmetatable({
        Gui = gui,
        Root = root,
        Titlebar = titlebar,
        TabBar = tabBar,
        Content = content,
        Tabs = {},
        ActiveTab = nil,
        _scale = scale,
    }, WindowMethods)

    makeDraggable(root, titlebar)

    local function updateScale()
        local camera = workspace.CurrentCamera
        if not camera then return end
        local viewport = camera.ViewportSize
        local availableX = math.max(260, viewport.X - 20)
        local availableY = math.max(250, viewport.Y - 40)
        root.Size = UDim2.fromOffset(math.min(620, availableX), math.min(430, availableY))
        scale.Scale = 1
    end
    updateScale()
    if workspace.CurrentCamera then
        workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
    end

    return self
end

function WindowMethods:Tab(options)
    options = options or {}
    local tabButton = button(self.TabBar, options.Name or "Tab", 30)
    tabButton.Size = UDim2.fromOffset(math.max(76, #tostring(options.Name or "Tab") * 8 + 24), 30)

    local page = create("ScrollingFrame", {
        Name = tostring(options.Name or "Tab") .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Library.Colors.Text,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, self.Content)

    local columns = create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
    }, page)
    local left = create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, -4, 1, 0),
    }, columns)
    local right = create("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0.5, 4, 0, 0),
        Size = UDim2.new(0.5, -4, 1, 0),
    }, columns)
    makeList(left, 8)
    makeList(right, 8)
    addPadding(left, 0, 4, 0, 8)
    addPadding(right, 4, 0, 0, 8)

    local tab = setmetatable({
        Name = options.Name or "Tab",
        Button = tabButton,
        Page = page,
        Left = left,
        Right = right,
        Window = self,
    }, TabMethods)

    tabButton.Activated:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)
    if not self.ActiveTab then
        self:SelectTab(tab)
    end
    return tab
end

function WindowMethods:SelectTab(tab)
    self.ActiveTab = tab
    for _, item in ipairs(self.Tabs) do
        item.Page.Visible = item == tab
        item.Button.BackgroundColor3 = item == tab and Library.Colors.Hover or Library.Colors.Element
        item.Button.TextColor3 = Library.Colors.Text
    end
end

function WindowMethods:Unload()
    if self.Gui then self.Gui:Destroy() end
end

function TabMethods:Section(options)
    options = options or {}
    local parent = string.lower(tostring(options.Side or "Left")) == "right" and self.Right or self.Left
    local frame = create("Frame", {
        Name = options.Name or "Section",
        BackgroundColor3 = Library.Colors.Panel,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 38),
        AutomaticSize = Enum.AutomaticSize.Y,
    }, parent)
    corner(frame, 5)
    stroke(frame)
    local heading = label(frame, options.Name or "Section", nil, UDim2.fromOffset(9, 0), UDim2.new(1, -18, 0, 30), 13)
    heading.Font = Enum.Font.GothamSemibold
    local body = create("Frame", {
        Name = "Controls",
        Position = UDim2.fromOffset(8, 32),
        Size = UDim2.new(1, -16, 0, 0),
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, frame)
    makeList(body, 6)
    addPadding(body, 0, 0, 0, 8)
    return setmetatable({Frame = frame, Body = body}, SectionMethods)
end

function SectionMethods:Button(options)
    options = options or {}
    local b = button(self.Body, options.Name or "Button", 30)
    b.Activated:Connect(function()
        if options.Callback then task.spawn(options.Callback) end
    end)
    return b
end

function SectionMethods:Toggle(options)
    options = options or {}
    local state = options.Default or false
    local row = button(self.Body, "", 30)
    local title = label(row, options.Name or "Toggle", nil, UDim2.fromOffset(9, 0), UDim2.new(1, -48, 1, 0), 12)
    local indicator = create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = state and Library.Colors.Text or Library.Colors.Window,
        BorderSizePixel = 0,
    }, row)
    corner(indicator, 3)
    stroke(indicator)
    local obj = setmetatable({Value = state, Button = row, Indicator = indicator, Options = options}, ToggleMethods)
    local function refresh()
        indicator.BackgroundColor3 = state and Library.Colors.Text or Library.Colors.Window
        title.TextColor3 = Library.Colors.Text
    end
    row.Activated:Connect(function()
        state = not state
        obj.Value = state
        refresh()
        if options.Callback then task.spawn(options.Callback, state) end
    end)
    obj.SetValue = function(_, value)
        state = not not value
        obj.Value = state
        refresh()
        if options.Callback then task.spawn(options.Callback, state) end
    end
    obj.Colorpicker = function(_, pickerOptions)
        pickerOptions = pickerOptions or {}
        local swatch = button(self.Body, pickerOptions.Name or "Color", 28)
        swatch.Activated:Connect(function()
            local colors = {Color3.fromRGB(255,255,255), Color3.fromRGB(180,180,180), Color3.fromRGB(90,90,90)}
            local current = swatch.BackgroundColor3
            local index = 1
            for i, c in ipairs(colors) do if c == current then index = i end end
            swatch.BackgroundColor3 = colors[index % #colors + 1]
            if pickerOptions.Callback then pickerOptions.Callback(swatch.BackgroundColor3) end
        end)
        return swatch
    end
    obj.Keybind = function(_, keyOptions)
        keyOptions = keyOptions or {}
        local keyButton = button(self.Body, (keyOptions.Name or "Keybind") .. ": click then press a key", 28)
        local listening = false
        keyButton.Activated:Connect(function()
            listening = true
            keyButton.Text = "Press a key..."
        end)
        local connection
        connection = UserInputService.InputBegan:Connect(function(input, processed)
            if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                keyButton.Text = (keyOptions.Name or "Keybind") .. ": " .. input.KeyCode.Name
                if keyOptions.Callback then task.spawn(keyOptions.Callback, input.KeyCode) end
            end
        end)
        return keyButton
    end
    refresh()
    return obj
end

function SectionMethods:Slider(options)
    options = options or {}
    local minimum = options.Min or 0
    local maximum = options.Max or 100
    local value = math.clamp(options.Default or minimum, minimum, maximum)
    local holder = create("Frame", {
        BackgroundColor3 = Library.Colors.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 48),
    }, self.Body)
    corner(holder, 4); stroke(holder)
    local textLabel = label(holder, (options.Name or "Slider") .. ": " .. tostring(value), nil, UDim2.fromOffset(8, 0), UDim2.new(1, -16, 0, 24), 12)
    local track = create("TextButton", {
        Text = "", AutoButtonColor = false,
        Position = UDim2.new(0, 8, 0, 30), Size = UDim2.new(1, -16, 0, 8),
        BackgroundColor3 = Library.Colors.Border, BorderSizePixel = 0,
    }, holder)
    corner(track, 4)
    local fill = create("Frame", {
        Size = UDim2.new((value - minimum) / math.max(1, maximum - minimum), 0, 1, 0),
        BackgroundColor3 = Library.Colors.Text, BorderSizePixel = 0,
    }, track)
    corner(fill, 4)
    local function setFromX(x)
        local ratio = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        value = math.floor(minimum + (maximum - minimum) * ratio)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        textLabel.Text = (options.Name or "Slider") .. ": " .. tostring(value)
        if options.Callback then options.Callback(value) end
    end
    track.Activated:Connect(function() setFromX(UserInputService:GetMouseLocation().X) end)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then setFromX(input.Position.X) end
    end)
    return {GetValue = function() return value end, SetValue = function(_, v)
        value = math.clamp(v, minimum, maximum)
        local ratio = (value - minimum) / math.max(1, maximum - minimum)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        textLabel.Text = (options.Name or "Slider") .. ": " .. tostring(value)
        if options.Callback then options.Callback(value) end
    end}
end

function SectionMethods:Dropdown(options)
    options = options or {}
    local selected = {}
    local b = button(self.Body, (options.Name or "Dropdown") .. " ▾", 30)
    local listFrame = create("Frame", {
        Visible = false,
        BackgroundColor3 = Library.Colors.Panel,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
    }, self.Body)
    corner(listFrame, 4); stroke(listFrame)
    local layout = makeList(listFrame, 3)
    addPadding(listFrame, 5, 5, 5, 5)
    for _, option in ipairs(options.Options or {}) do
        local item = button(listFrame, tostring(option), 27)
        item.Activated:Connect(function()
            if options.Multi then
                selected[option] = not selected[option]
            else
                selected = {[option] = true}
                listFrame.Visible = false
            end
            b.Text = (options.Name or "Dropdown") .. ": " .. tostring(option)
            if options.Callback then options.Callback(options.Multi and selected or option) end
        end)
    end
    b.Activated:Connect(function() listFrame.Visible = not listFrame.Visible end)
    return {GetValue = function() return selected end}
end

function SectionMethods:Textbox(options)
    options = options or {}
    local box = create("TextBox", {
        ClearTextOnFocus = false,
        PlaceholderText = options.Name or "Enter text",
        Text = options.Default or "",
        TextColor3 = Library.Colors.Text,
        PlaceholderColor3 = Library.Colors.MutedText,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundColor3 = Library.Colors.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 30),
    }, self.Body)
    addPadding(box, 8, 8, 0, 0)
    corner(box, 4); stroke(box)
    box.FocusLost:Connect(function(enterPressed)
        if options.Callback then options.Callback(box.Text, enterPressed) end
    end)
    return box
end

